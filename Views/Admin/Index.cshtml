@using System.Globalization
@using sumile.Models
@using sumile.Services
@using sumile.ViewModels
@model AdminDashboardViewModel
@inject ShiftStatusDisplayService ShiftDisplay

@{
    ViewData["Title"] = "シフト一覧(管理者用)";

    var table = Model.Table;
    var recruitmentPeriods = Model.RecruitmentPeriods;
    int? selectedPeriodId = Model.SelectedPeriodId;
    var users = Model.Users.OrderBy(u => u.CustomId);
    var shiftDays = table.ShiftDays;
    var submissions = table.Submissions;
    var workloadCells = table.WorkloadCells;
    var shiftColumns = table.ShiftColumns;
    var diffKeys = Model.DiffKeys;
    var totalAcceptedList = table.TotalAcceptedList;
    var keyHolderAcceptedList = table.KeyHolderAcceptedList;
    var requiredWorkersList = table.RequiredWorkersList;
    var remainingWorkersList = table.RemainingWorkersList;
    var submittedUserCount = Model.SubmittedUserCount;
    var targetUserCount = Model.TargetUserCount;
    var unsubmittedUsers = Model.UnsubmittedUsers;
    var assignmentSummary = Model.AssignmentSummary;
    var userShiftStats = Model.UserShiftStats;
    var shiftPdfUrl = Model.ShiftPdfUrl;
    var shiftPdfUpdatedAt = Model.ShiftPdfUpdatedAt;
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning">@TempData["WarningMessage"]</div>
}

@if (TempData["AutoAssignSummary"] != null)
{
    <div class="alert alert-info">
        <div class="fw-semibold">自動割当結果</div>
        <div>@TempData["AutoAssignSummary"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a href="@Url.Action("SetRecruitmentPeriod", "Admin")" class="btn btn-primary">募集期間設定</a>
    <a href="@Url.Action("EditShifts", "Admin")" class="btn btn-secondary">シフト編集</a>
    <a href="@Url.Action("ShiftEditLogs", "Admin")" class="btn btn-info">編集履歴</a>

    <form asp-action="AutoAssignShifts" asp-controller="Admin" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="periodId" value="@selectedPeriodId" />
        <button type="submit" class="btn btn-warning" onclick="return confirm('この期間のシフトを自動割り当てしますか？');">
            シフト自動割り当て
        </button>
    </form>

    <a href="@Url.Action("EditDailyWorkload", "Admin")" class="btn btn-success">枚数編集</a>

    @if (selectedPeriodId != null)
    {
        <form asp-action="RegeneratePdf" asp-controller="Admin" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="periodId" value="@selectedPeriodId" />
            <button type="submit" class="btn btn-outline-dark">この期間のPDFを今すぐ再出力</button>
        </form>
    }
</div>

<div class="mb-3">
    <label for="periodSelect">表示期間：</label>
    <select id="periodSelect" class="form-select" style="width:auto; display:inline;">
        @foreach (var rp in recruitmentPeriods)
        {
            <option value="@rp.Id" selected="@(rp.Id == selectedPeriodId)">
                @rp.StartDate.ToString("yyyy/MM/dd") ～ @rp.EndDate.ToString("yyyy/MM/dd")
            </option>
        }
    </select>

    @if (selectedPeriodId != null)
    {
        var selectedPeriod = recruitmentPeriods.FirstOrDefault(p => p.Id == selectedPeriodId);
        if (selectedPeriod != null)
        {
            <form asp-action="ToggleSubmissionStatus" asp-controller="Admin" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@selectedPeriod.Id" />
                <button type="submit" class="btn btn-outline-warning ms-2">
                    @(selectedPeriod.IsOpen ? "締切にする" : "募集中に戻す")
                </button>
            </form>
        }
    }
</div>

@if (selectedPeriodId != null)
{
    <div class="alert @(unsubmittedUsers.Any() ? "alert-warning" : "alert-success")">
        <div class="fw-semibold">提出状況: @submittedUserCount / @targetUserCount 人</div>
        @if (unsubmittedUsers.Any())
        {
            <div class="small mt-2 fw-semibold">未提出者一覧</div>
            <div class="d-flex flex-wrap gap-1 mt-1">
                @foreach (var userName in unsubmittedUsers)
                {
                    <span class="badge bg-light text-dark border">@userName</span>
                }
            </div>
        }
        else
        {
            <div class="small mt-1">対象ユーザーは全員提出済みです。</div>
        }
    </div>
}

<div class="table-responsive mb-4">
    <table class="table table-sm table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>対象枠</th>
                <th>必要人数</th>
                <th>割当人数</th>
                <th>鍵持ち割当</th>
                <th>人数不足</th>
                <th>鍵持ち不足</th>
                <th>超過</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@assignmentSummary.ShiftCellCount</td>
                <td>@assignmentSummary.RequiredWorkerTotal</td>
                <td>@assignmentSummary.AssignedTotal</td>
                <td>@assignmentSummary.KeyHolderAssignedTotal</td>
                <td class="@(assignmentSummary.WorkerShortageSlotCount > 0 ? "text-danger fw-semibold" : "")">
                    @assignmentSummary.WorkerShortageSlotCount
                    <span class="text-muted small">(@assignmentSummary.WorkerShortageCellCount 枠)</span>
                </td>
                <td class="@(assignmentSummary.KeyHolderShortageSlotCount > 0 ? "text-danger fw-semibold" : "")">
                    @assignmentSummary.KeyHolderShortageSlotCount
                    <span class="text-muted small">(@assignmentSummary.KeyHolderShortageCellCount 枠)</span>
                </td>
                <td>@assignmentSummary.OverAssignedSlotCount</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="admin-pdf-preview mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <div>
            <h3 class="h5 mb-1">最新PDF</h3>
            @if (shiftPdfUpdatedAt.HasValue)
            {
                <div class="text-muted small">更新: @shiftPdfUpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(shiftPdfUrl))
        {
            <a href="@shiftPdfUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">別タブで開く</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(shiftPdfUrl))
    {
        <object data="@shiftPdfUrl" type="application/pdf" class="admin-pdf-frame">
            <div class="text-muted small">
                PDFを表示できませんでした。<a href="@shiftPdfUrl" target="_blank" rel="noopener">別タブで開く</a>
            </div>
        </object>
    }
    else
    {
        <div class="admin-pdf-empty text-muted">
            この期間のPDFはまだ出力されていません。
        </div>
    }
</div>

<div class="mb-4">
    <h3 class="h5">ユーザー別 割当状況</h3>
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>ユーザー</th>
                    <th>鍵</th>
                    <th>提出</th>
                    <th>希望数</th>
                    <th>割当数</th>
                    <th>鍵持ち割当</th>
                    <th>空白数</th>
                    <th>空白率</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stat in userShiftStats)
                {
                    <tr>
                        <td>@stat.CustomId</td>
                        <td class="text-start">@stat.Name</td>
                        <td>@(stat.UserShiftRole == UserShiftRole.KeyHolder ? "★" : "")</td>
                        <td>
                            @if (stat.HasSubmitted)
                            {
                                <span class="badge bg-success">済</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">未</span>
                            }
                        </td>
                        <td>@stat.RequestedCount</td>
                        <td>@stat.AssignedCount</td>
                        <td>@stat.KeyHolderAssignedCount</td>
                        <td>@stat.BlankCount</td>
                        <td>
                            @(stat.RequestedCount == 0 ? "-" : $"{stat.BlankRate * 100:0.#}%")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.getElementById('periodSelect')?.addEventListener('change', function () {
        location.href = '@Url.Action("Index", "Admin")?periodId=' + this.value;
    });
</script>

<style>
    .current-user-row { background-color: #f3e8ff; }
    .shift-none { color: gray; }
    .shift-accepted { color: black; }
    .shift-want { color: orange; }
    .shift-keyholder { color: red; }
    .highlight-cell { background-color: #fff3cd; }
</style>

<div class="text-muted small mb-2">
    表上段の数値は必要枚数です。下段の必要人数・残りは人数で表示しています。
</div>

<div class="shift-table-fit shift-table-fixed-2" role="region" aria-label="管理者用シフト表" tabindex="0">
<table class="table table-bordered text-center">
    <thead>
        <tr>
            <th rowspan="4">ユーザー</th>
            <th rowspan="4">鍵</th>
            @foreach (var day in shiftDays)
            {
                <th colspan="2">@day.Date.ToString("M/d")</th>
            }
        </tr>
        <tr>
            @foreach (var day in shiftDays)
            {
                <th colspan="2">@day.Date.ToString("ddd", new CultureInfo("ja-JP"))</th>
            }
        </tr>
        <tr>
            @foreach (var _ in shiftDays)
            {
                <th>上</th>
                <th>敷</th>
            }
        </tr>
        <tr>
            @foreach (var cell in workloadCells)
            {
                <td colspan="@cell.Colspan">@cell.RequiredCount</td>
            }
        </tr>
    </thead>

    <tbody>
        @foreach (var user in users)
        {
            bool isCurrentUser =
                Model.CurrentUserCustomId != null &&
                user.CustomId.ToString() == Model.CurrentUserCustomId;

            <tr class="@(isCurrentUser ? "current-user-row" : "")">
                <td>@user.Name</td>
                <td>@(user.UserShiftRole == UserShiftRole.KeyHolder ? "★" : "")</td>

                @foreach (var column in shiftColumns)
                {
                    var submission = submissions.FirstOrDefault(s =>
                        s.UserId == user.Id &&
                        s.ShiftDayId == column.ShiftDayId &&
                        s.ShiftType == column.ShiftType);

                    var key = $"{user.Id}_{column.ShiftDayId}_{(int)column.ShiftType}";
                    var display = ShiftDisplay.GetDisplay(submission?.ShiftStatus);

                    if (submission?.UserShiftRole == UserShiftRole.KeyHolder && display.Symbol == "〇")
                        display.CssClass += " shift-keyholder";

                    <td class="@(diffKeys.Contains(key) ? "highlight-cell" : "") @display.CssClass">
                        @display.Symbol
                    </td>
                }
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <td colspan="2">必要人数</td>
            @foreach (var v in requiredWorkersList)
            {
                <td>@v</td>
            }
        </tr>

        <tr>
            <td colspan="2">〇</td>
            @foreach (var v in totalAcceptedList)
            {
                <td>@v</td>
            }
        </tr>
        <tr>
            <td colspan="2">赤丸</td>
            @foreach (var v in keyHolderAcceptedList)
            {
                <td>@v</td>
            }
        </tr>
        <tr>
            <td colspan="2">残り</td>
            @foreach (var v in remainingWorkersList)
            {
                <td class="@(v < 0 ? "text-danger fw-bold" : "")">@v</td>
            }
        </tr>
    </tfoot>
</table>
</div>
