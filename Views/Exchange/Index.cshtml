@model sumile.ViewModels.ExchangeIndexPageViewModel
@using sumile.Models

@{
    ViewData["Title"] = "シフト交換掲示板";
    var currentUserId = Model.CurrentUserId;
    var currentUserRole = Model.CurrentUserRole;
    var isAdmin = Model.IsAdmin;
    var relatedOnly = Model.RelatedOnly;
}

<h2 class="mb-4">シフト交換掲示板</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">新しい交換希望を出す</a>
</p>

<form method="get" asp-action="Index" class="mb-3">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="relatedOnly" name="relatedOnly" value="true"
               checked="@(relatedOnly ? "checked" : null)"
               onchange="this.form.submit()" />
        <label class="form-check-label" for="relatedOnly">自分に関係ある交換だけ表示</label>
    </div>
</form>

<table class="table table-bordered text-center">
    <thead class="table-light">
        <tr>
            <th>交換提出者</th>
            <th>譲りたいシフト</th>
            <th>表示先</th>
            <th>応募者</th>
            <th>ステータス</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Exchanges)
        {
            var offered = item.OfferedShiftSubmission;
            var accepted = item.AcceptedShiftSubmission;
            var isOwnRequest = item.RequestedByUserId == currentUserId;
            var isOwnApplication = item.AcceptedByUserId == currentUserId;
            var isTargetedToOtherUser = !string.IsNullOrEmpty(item.TargetUserId) && item.TargetUserId != currentUserId;
            var canApply = item.Status == ShiftExchange.StatusOpen && offered != null && !isOwnRequest && !isTargetedToOtherUser;
            var canCancelRequest = isOwnRequest && IsCancelableByRequester(item.Status);
            var canCancelApplication = isOwnApplication && IsPendingApproval(item.Status);
            var canFinalize = IsPendingApproval(item.Status) && isAdmin;
            var canReject = IsPendingApproval(item.Status) && isAdmin;

            // ↓ ShiftDay 経由で取得（ShiftSubmission.Date は使用しない）
            var shiftDateStr = offered?.ShiftDay?.Date.ToString("yyyy-MM-dd") ?? "";
            var shiftTypeInt = (int)(offered?.ShiftType ?? ShiftType.Morning);
            var periodId = offered?.ShiftDay?.RecruitmentPeriodId ?? 0;
            var targetUserRole = offered?.UserShiftRole.ToString() ?? "Normal";

            <tr>
                <td>@(item.RequestedByUser?.Name ?? "―")</td>

                <td>
                    @if (offered != null)
                    {
                        <span>
                            @($"{offered.ShiftDay?.Date:yyyy/MM/dd}（{ConvertShiftType(offered.ShiftType)}）[{ConvertRoleToLabel(offered.UserShiftRole)}]")
                        </span>
                    }
                    else
                    {
                        <span>―</span>
                    }
                </td>

                <td>
                    @if (item.TargetUser != null)
                    {
                        <span>@item.TargetUser.Name</span>
                    }
                    else
                    {
                        <span class="text-muted">全員</span>
                    }
                </td>

                <td>
                    @if (item.AcceptedByUser != null)
                    {
                        <span>@item.AcceptedByUser.Name</span>
                        @if (accepted != null)
                        {
                            <span class="text-muted small">
                                @($" / {accepted.ShiftDay?.Date:yyyy/MM/dd}（{ConvertShiftType(accepted.ShiftType)}）")
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">未応募</span>
                    }
                </td>

                <td>
                    @Html.Raw(StatusBadge(item.Status))
                </td>

                <td>
                    <div class="d-flex flex-wrap justify-content-center gap-1">
                        @if (canApply)
                        {
                            <form asp-action="Select" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return checkExchangeCapacity(this, '@shiftDateStr', '@shiftTypeInt', @periodId, '@currentUserRole', '@targetUserRole');">
                                <button type="submit" class="btn btn-sm btn-outline-primary">この交換に応募</button>
                            </form>
                        }

                        @if (canCancelRequest)
                        {
                            <form asp-action="CancelRequest" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('この交換募集を取り消しますか？');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">募集を取消</button>
                            </form>
                        }

                        @if (canCancelApplication)
                        {
                            <form asp-action="CancelApplication" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('この応募を取り消しますか？');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">応募を取消</button>
                            </form>
                        }

                        @if (canFinalize)
                        {
                            <form asp-action="FinalizeExchange" method="post" class="d-inline">
                                <input type="hidden" name="exchangeId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-success">確定する</button>
                            </form>
                        }

                        @if (canReject)
                        {
                            <form asp-action="RejectExchange" method="post" class="d-inline"
                                  onsubmit="return confirm('この交換を却下しますか？');">
                                <input type="hidden" name="exchangeId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">却下する</button>
                            </form>
                        }

                        @if (!canApply && !canCancelRequest && !canCancelApplication && !canFinalize && !canReject)
                        {
                            @if (IsPendingApproval(item.Status))
                            {
                                <span class="text-muted">管理者承認待ち</span>
                            }
                            else if (isOwnRequest && item.Status == ShiftExchange.StatusOpen)
                            {
                                <span class="text-muted">応募待ち</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    string ConvertRoleToLabel(UserShiftRole? role)
    {
        return role switch
        {
            UserShiftRole.New => "N",
            UserShiftRole.Normal => "NK",
            UserShiftRole.KeyHolder => "鍵",
            _ => "―"
        };
    }

    string ConvertShiftType(ShiftType type)
    {
        return type switch
        {
            ShiftType.Morning => "朝",
            ShiftType.Night => "夜",
            _ => "？"
        };
    }

    bool IsPendingApproval(string status)
    {
        return status == ShiftExchange.StatusPendingApproval ||
               status == ShiftExchange.StatusAcceptedLegacy;
    }

    bool IsCancelableByRequester(string status)
    {
        return status == ShiftExchange.StatusOpen || IsPendingApproval(status);
    }

    string StatusBadge(string status)
    {
        return status switch
        {
            ShiftExchange.StatusFinalized => "<span class=\"badge bg-success\">確定</span>",
            ShiftExchange.StatusCanceled => "<span class=\"badge bg-secondary\">取消済み</span>",
            ShiftExchange.StatusRejected => "<span class=\"badge bg-danger\">却下</span>",
            ShiftExchange.StatusPendingApproval => "<span class=\"badge bg-info text-dark\">仮成立</span>",
            ShiftExchange.StatusAcceptedLegacy => "<span class=\"badge bg-info text-dark\">仮成立</span>",
            _ => "<span class=\"badge bg-warning text-dark\">募集中</span>"
        };
    }
}

<script>
    async function checkExchangeCapacity(form, date, shiftType, periodId, currentUserRole, targetUserRole) {
        if (currentUserRole === targetUserRole) return true;

        try {
            const res = await fetch(`/Exchange/GetShiftStatusInfo?date=${date}&shiftType=${shiftType}&periodId=${periodId}`);
            const data = await res.json();

            const redLimit = Math.floor(data.total / 2);
            const redCount = data.redCount;

            if (targetUserRole === "KeyHolder" && redCount >= redLimit) {
                return confirm("赤丸の上限に達しています。この交換をすると鍵持ちでも黒丸になります。続行しますか？");
            }

            if (targetUserRole === "KeyHolder" && redCount < redLimit) {
                return confirm(`現在この時間帯の赤丸は ${redCount} 人です（上限 ${redLimit}）。\n赤丸が不足すると運営に支障が出る可能性があります。\nそれでも交換を続けますか？`);
            }

        } catch (error) {
            alert("人数情報の取得に失敗しました。通信エラーの可能性があります。");
            return false;
        }

        return true;
    }
</script>
